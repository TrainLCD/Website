---
import { heroImageSizes } from './heroImageSizes';
import ImageWithoutSize from '../ImageWithoutSize.astro';
import StoreBadges from '../StoreBadges.astro';
import mockImage from '../../assets/images/mockup/phone-landscape.png';
import styles from './Hero.module.css';

import portrait from '../../assets/images/mockup/phone-portrait.png';

const { lcpImageSources = [] } = Astro.props;
---

<section class={styles.container}>
  <div class={styles.inner}>
    <p class={styles.eyebrow}>iOS・Android 対応 / 無料</p>
    <h1 class={styles.heading}>電車のあの画面、<br />持ち歩けます。</h1>
    <p class={styles.description}>
      次に停まる駅、停車駅、行先。<br />
      車内の案内表示そのままの見た目を、あなたのスマートフォンで。
    </p>
    <StoreBadges class={styles.stores} loading="eager" />
    <div class={styles.media}>
      <ImageWithoutSize
        src={mockImage}
        imageSources={lcpImageSources}
        alt="TrainLCDの走行画面（湘南新宿ライン 新宿→渋谷・逗子ゆき）"
        widths={[480, 640, 768, 960, 1280, 1600]}
        sizes={heroImageSizes}
        format="webp"
        loading="eager"
        decoding="async"
        priority
      />
      <div class={styles.portrait}>
        <ImageWithoutSize src={portrait} alt="縦画面の停車駅一覧" widths={[240, 480]} sizes="16vw" />
      </div>
    </div>
  </div>
</section>
