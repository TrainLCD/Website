---
import Footer from '../Footer';
import Header from '../Header';
import CommunitySection from '../sections/Community.astro';
import DownloadSection from '../sections/Download.astro';
import FeaturesSection from '../sections/Features.astro';
import HeroSection from '../sections/Hero.astro';
import TabletSection from '../sections/Tablet.astro';
import WearableSection from '../sections/Wearable.astro';

const { lcpImageSources = [] } = Astro.props;
---

<main>
  <Header client:load />
  <HeroSection lcpImageSources={lcpImageSources} />
  <FeaturesSection />
  <TabletSection />
  <WearableSection />
  <CommunitySection />
  <DownloadSection />
  <Footer />
</main>
